#%Module1.0

module-whatis "sander26"
module-whatis "Compiled on CPU"
conflict amber

proc ModulesHelp { } {
    puts stderr "mpirun -n \$SLURM_NTASKS_PER_NODE sander.MPI"
}

set base /home/van/Programs/sander26

# Sander reads Amber data below AMBERHOME. Restore inherited selections on unload;
# retain PMEMDHOME as the legacy alias used by existing local scripts.
pushenv AMBERHOME $base
pushenv PMEMDHOME $base

# libplumed.so needs libplumedKernel.so indirectly; Sander's own RUNPATH
# does not resolve that dependency. Expose runtime libraries without adding
# the full PLUMED module's Python or compiler search paths.
prepend-path LD_LIBRARY_PATH /home/van/Programs/plumed-2.9.4/lib
prepend-path LD_LIBRARY_PATH [file join $base lib]
prepend-path PATH [file join $base bin]
